<!-- Local rules -->


<!-- ========================================================= -->
<!-- Example local SSH rule                                    -->
<!-- ========================================================= -->

<group name="local,syslog,sshd,">

  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>

    <description>sshd: authentication failed from IP 1.1.1.1.</description>

    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>



<!-- ========================================================= -->
<!-- OT / ICS - Zeek Modbus detection                          -->
<!-- ========================================================= -->

<group name="ot,ics,zeek,modbus,">


  <!-- ======================================================= -->
  <!-- 100100 - Generic Modbus WRITE visibility               -->
  <!-- ======================================================= -->

  <rule id="100100" level="5">
    <decoded_as>json</decoded_as>

    <field name="func"
           type="pcre2">^WRITE_</field>

    <field name="pdu_type">^REQ$</field>

    <description>OT: Modbus write observed - $(func) from $(id.orig_h) to $(id.resp_h)</description>

    <group>ot,ics,modbus,modbus_write,</group>
  </rule>



  <!-- ======================================================= -->
  <!-- 100101 - Unauthorized Modbus WRITE to PLC01            -->
  <!-- MITRE ATT&CK for ICS: T1692.001                        -->
  <!-- Unauthorized Message: Command Message                  -->
  <!-- ======================================================= -->

  <rule id="100101" level="12">
    <decoded_as>json</decoded_as>

    <field name="func"
           type="pcre2">^WRITE_</field>

    <field name="pdu_type">^REQ$</field>

    <field name="id.resp_h">^10\.10\.40\.41$</field>


    <!--
      Approved OT clients:

      ENG-WS01
      10.10.30.20

      OT-HIST01
      10.10.40.30
    -->

    <field name="id.orig_h"
           type="pcre2"
           negate="yes">^(10\.10\.30\.20|10\.10\.40\.30)$</field>


    <description>OT CRITICAL [MITRE ICS T1692.001]: Unauthorized Modbus write from $(id.orig_h) to PLC01 $(id.resp_h) - $(func)</description>


    <group>ot,ics,modbus,unauthorized_write,control_manipulation,attack_ics_t1692_001,</group>

  </rule>



  <!-- ======================================================= -->
  <!-- 110200 - WRITE_SINGLE_REGISTER visibility              -->
  <!-- ======================================================= -->

  <rule id="110200" level="10">
    <decoded_as>json</decoded_as>

    <field name="func">^WRITE_SINGLE_REGISTER$</field>
    <field name="pdu_type">^REQ$</field>

    <description>OT - Modbus WRITE_SINGLE_REGISTER request detected</description>

    <group>ics,modbus,write,</group>

  </rule>



  <!-- ======================================================= -->
  <!-- 110201 - WRITE_SINGLE_COIL visibility                  -->
  <!-- ======================================================= -->

  <rule id="110201" level="10">
    <decoded_as>json</decoded_as>

    <field name="func">^WRITE_SINGLE_COIL$</field>
    <field name="pdu_type">^REQ$</field>

    <description>OT - Modbus WRITE_SINGLE_COIL request detected</description>

    <group>ics,modbus,write,control_manipulation,</group>

  </rule>



  <!-- ======================================================= -->
  <!-- 100102 - Unauthorized process-state READ               -->
  <!-- MITRE ATT&CK for ICS: T0801 Monitor Process State      -->
  <!-- ======================================================= -->

  <rule id="100102" level="9">
    <decoded_as>json</decoded_as>

    <field name="id.resp_h">^10\.10\.40\.41$</field>
    <field name="id.resp_p">^502$</field>

    <field name="pdu_type">^REQ$</field>


    <!-- READ operations only -->

    <field name="func"
           type="pcre2">^READ_</field>


    <!-- Exclude approved OT clients -->

    <field name="id.orig_h"
           type="pcre2"
           negate="yes">^(10\.10\.30\.20|10\.10\.40\.30)$</field>


    <description>OT WARNING [MITRE ICS T0801]: Unauthorized Modbus process read by $(id.orig_h) against PLC01 - $(func)</description>


    <group>ot,ics,modbus,unauthorized_client,process_monitoring,attack_ics_t0801,</group>

  </rule>



  <!-- ======================================================= -->
  <!-- 100103 - Historian role violation                      -->
  <!-- Historian may READ PLC data but must not WRITE         -->
  <!-- MITRE ATT&CK for ICS: T1692.001                        -->
  <!-- ======================================================= -->

  <rule id="100103" level="12">
    <decoded_as>json</decoded_as>

    <field name="id.orig_h">^10\.10\.40\.30$</field>
    <field name="id.resp_h">^10\.10\.40\.41$</field>
    <field name="id.resp_p">^502$</field>

    <field name="func"
           type="pcre2">^WRITE_</field>

    <field name="pdu_type">^REQ$</field>


    <description>OT CRITICAL [MITRE ICS T1692.001]: Historian attempted unauthorized Modbus write to PLC01 - $(func)</description>


    <group>ot,ics,modbus,historian_write,control_manipulation,role_violation,attack_ics_t1692_001,</group>

  </rule>



  <!-- ======================================================= -->
  <!-- 100104 - Repeated unauthorized process reads           -->
  <!-- MITRE ATT&CK for ICS: T0801 Monitor Process State      -->
  <!-- ======================================================= -->

  <rule id="100104"
        level="11"
        frequency="5"
        timeframe="10">

    <if_matched_sid>100102</if_matched_sid>

    <same_field>id.orig_h</same_field>


    <description>OT HIGH [MITRE ICS T0801]: Repeated unauthorized Modbus process reads from $(id.orig_h) against PLC01</description>


    <group>ot,ics,modbus,reconnaissance,process_monitoring,attack_ics_t0801,</group>

  </rule>


</group>



<!-- ========================================================= -->
<!-- pfSense firewall detection                                -->
<!-- ========================================================= -->

<group name="pfsense,firewall,reconnaissance,">

  <rule id="110100" level="8">
    <decoded_as>pfsense-filterlog</decoded_as>

    <srcip>10.10.50.10</srcip>
    <dstip>10.10.30.20</dstip>

    <protocol>tcp</protocol>


    <description>LAB - ATTACKER01 TCP reconnaissance detected against ENG-WS01</description>


    <group>network,reconnaissance,</group>

  </rule>

</group>



<!-- ========================================================= -->
<!-- Conpot deception / honeypot                               -->
<!-- ========================================================= -->

<group name="ot,ics,conpot,honeypot,">


  <!-- ======================================================= -->
  <!-- 120000 - Generic Conpot interaction                    -->
  <!-- ======================================================= -->

  <rule id="120000" level="8">
    <decoded_as>conpot-connection</decoded_as>

    <match>New Modbus connection from</match>

    <description>CONPOT WARNING: Honeypot Modbus connection detected</description>

    <group>ot,ics,conpot,honeypot,deception,</group>
  </rule>


  <!-- ======================================================= -->
  <!-- 120001 - Modbus interaction with Conpot                -->
  <!-- ======================================================= -->

  <rule id="120001" level="9">
    <if_sid>120000</if_sid>

    <match>Modbus</match>

    <description>CONPOT WARNING: Modbus honeypot interaction detected</description>

    <group>ot,ics,modbus,conpot,honeypot,deception,</group>

  </rule>



  <!-- ======================================================= -->
  <!-- 120002 - Repeated Conpot Modbus probing                -->
  <!-- ======================================================= -->

  <rule id="120002"
        level="11"
        frequency="5"
        timeframe="60">

    <if_matched_sid>120001</if_matched_sid>


    <description>CONPOT CRITICAL: Repeated Modbus honeypot activity detected</description>


    <group>ot,ics,modbus,conpot,honeypot,deception,reconnaissance,</group>

  </rule>


</group>



<!-- ========================================================= -->
<!-- Process-aware OT monitoring                               -->
<!-- ========================================================= -->

<group name="ot_process_monitoring,">


  <!-- ======================================================= -->
  <!-- 110500 - Synthetic process event parent                -->
  <!-- Retained for process-rule testing                      -->
  <!-- ======================================================= -->

  <rule id="110500" level="0">
    <decoded_as>json</decoded_as>

    <field name="event_type">^process_write$</field>

    <description>Industrial process write event</description>

  </rule>



  <!-- ======================================================= -->
  <!-- 110501 - Synthetic TANK_LEVEL safety validation        -->
  <!-- Normal integer range: 0-80                             -->
  <!-- ======================================================= -->

  <rule id="110501" level="10">

    <if_sid>110500</if_sid>

    <field name="tag">^TANK_LEVEL$</field>

    <field name="value"
           type="pcre2">^(?:-[0-9]+|8[1-9]|9[0-9]|[1-9][0-9]{2,})$</field>


    <description>Unsafe tank process value detected</description>


    <group>ot_process,safety_violation,</group>

  </rule>



  <!-- ======================================================= -->
  <!-- 110510 - Real Zeek track-memmap LEVEL_SP observation   -->
  <!--                                                       -->
  <!-- PyModbus holding register address 3                    -->
  <!-- appears as register 4 in Zeek track-memmap             -->
  <!-- ======================================================= -->

  <rule id="110510" level="3">
    <decoded_as>json</decoded_as>

    <field name="id.resp_h">^10\.10\.40\.41$</field>
    <field name="register">^4$</field>


    <description>OT PROCESS: PLC01 LEVEL_SP observed changing from $(old_val) to $(new_val) via client $(id.orig_h)</description>


    <group>ot,ics,modbus,process_change,setpoint_change,</group>

  </rule>



  <!-- ======================================================= -->
  <!-- 110511 - Abnormal LEVEL_SP                             -->
  <!--                                                       -->
  <!-- Approved range: 40-80                                 -->
  <!--                                                       -->
  <!-- MITRE ATT&CK for ICS:                                 -->
  <!-- T0836 Modify Parameter                                -->
  <!-- ======================================================= -->

  <rule id="110511" level="10">

    <if_sid>110510</if_sid>


    <!--
      Trigger when new value is:

      0-39
      81-99
      100+
    -->

    <field name="new_val"
           type="pcre2">^(?:[0-9]|[1-3][0-9]|8[1-9]|9[0-9]|[1-9][0-9]{2,})$</field>


    <description>OT HIGH [MITRE ICS T0836]: PLC01 LEVEL_SP outside approved range (40-80): $(old_val) -> $(new_val)</description>


    <group>ot,ics,modbus,process_anomaly,setpoint_violation,attack_ics_t0836,</group>

  </rule>



  <!-- ======================================================= -->
  <!-- 110512 - High-confidence context-aware correlation     -->
  <!--                                                       -->
  <!-- Correlates:                                           -->
  <!--                                                       -->
  <!-- 100101                                                -->
  <!-- Unauthorized Modbus WRITE                             -->
  <!--                                                       -->
  <!--        +                                              -->
  <!--                                                       -->
  <!-- 110511                                                -->
  <!-- Abnormal LEVEL_SP                                     -->
  <!--                                                       -->
  <!-- within 30 seconds                                     -->
  <!--                                                       -->
  <!-- MITRE ATT&CK for ICS:                                 -->
  <!-- T1692.001 Unauthorized Message: Command Message       -->
  <!-- T0836     Modify Parameter                            -->
  <!--                                                       -->
  <!-- NOTE:                                                 -->
  <!-- frequency=2 requires repeated matching 100101 events  -->
  <!-- during the correlation window.                        -->
  <!-- ======================================================= -->



</group>
