<group name="ot,ics,asset_context,risk_scoring,">

  <rule id="140100" level="14">
    <if_sid>100101</if_sid>

    <list field="id.resp_h" lookup="address_match_key">etc/lists/ot-critical-assets</list>

    <description>OT CRITICAL RISK [80/100]: Unauthorized Modbus write targeting critical OT asset $(id.resp_h) from $(id.orig_h)</description>

    <group>ot,ics,asset_context,asset_criticality_critical,risk_critical,risk_score_80,</group>
  </rule>
  <rule id="140101" level="11">
  <if_sid>100102</if_sid>

  <list field="id.resp_h" lookup="address_match_key">etc/lists/ot-critical-assets</list>

  <description>OT HIGH RISK [60/100]: Unauthorized Modbus read targeting critical OT asset $(id.resp_h) from $(id.orig_h)</description>

  <group>ot,ics,asset_context,asset_criticality_critical,risk_high,risk_score_60,</group>
</rule>
  <rule id="140102" level="15">
  <if_sid>130100</if_sid>

  <list field="id.resp_h" lookup="address_match_key">etc/lists/ot-critical-assets</list>

  <description>OT CRITICAL RISK [90/100]: Known threat-intelligence IOC $(id.orig_h) communicating with critical OT asset $(id.resp_h)</description>

  <group>ot,ics,asset_context,threat_intel,asset_criticality_critical,risk_critical,risk_score_90,</group>
</rule>

<rule id="110512" level="15" frequency="2" timeframe="30">
  <if_sid>140100</if_sid>
  <if_matched_sid>110511</if_matched_sid>
  <same_field>id.resp_h</same_field>

  <list field="id.resp_h" lookup="address_match_key">etc/lists/ot-critical-assets</list>

  <description>OT CRITICAL RISK [100/100] [MITRE ICS T1692.001 + T0836]: High-confidence abnormal process change temporally correlated with unauthorized manipulation of critical OT asset $(id.resp_h)</description>

  <group>ot,ics,modbus,context_aware,process_manipulation,high_confidence,asset_context,asset_criticality_critical,risk_critical,risk_score_100,attack_ics_t1692_001,attack_ics_t0836,</group>
</rule>

</group>
